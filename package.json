{
  "name": "travneeds-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build:web && npm run build:api",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json --noEmit",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.build.json",
    "start": "node dist/server/server/src/index.js",
    "test": "tsx --test server/tests/foundation.test.ts server/tests/finance.test.ts server/tests/settings.test.ts server/tests/quotations.test.ts && tsx docs/scripts/test-core-integration.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "setup:local": "tsx docs/scripts/configure-local.ts",
    "db:setup": "tsx docs/scripts/setup-database.ts",
    "db:migrate": "tsx docs/scripts/migrate.ts",
    "admin:create": "tsx docs/scripts/create-admin.ts",
    "format": "prettier --write src server/src server/tests shared docs/scripts \"server/tsconfig*.json\" vite.config.ts tailwind.config.js eslint.config.js",
    "format:check": "prettier --check src server/src server/tests shared docs/scripts \"server/tsconfig*.json\" vite.config.ts tailwind.config.js eslint.config.js"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "@lottiefiles/dotlottie-react": "^0.19.8",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "apexcharts": "^5.10.6",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "entities": "^9.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^12.42.2",
    "helmet": "^8.3.0",
    "image-size": "^2.1.0",
    "jose": "^6.2.18",
    "lucide-react": "^0.344.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "puppeteer-core": "^25.18.1",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.7.1",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "postcss": "^8.4.35",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
